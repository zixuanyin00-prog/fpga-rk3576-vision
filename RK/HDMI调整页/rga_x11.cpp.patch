+static void clipped_outline(Viewer* viewer, Slot* slot, const im_rect& viewport,
+                            int left, int top, int right, int bottom, unsigned color) {
+ const int x_max = viewport.x + viewport.width - 1;
+ const int y_max = viewport.y + viewport.height - 1;
+ for (int inset = 0; inset < 2; ++inset) {
+  const int l = left + inset, t = top + inset, r = right - inset, b = bottom - inset;
+  if (l > r || t > b) break;
+  const int x0 = std::max(l, viewport.x), x1 = std::min(r, x_max);
+  const int y0 = std::max(t, viewport.y), y1 = std::min(b, y_max);
+  // Clip each visible original edge. A cropped edge does not become a new border.
+  if (x0 <= x1 && y0 <= y1) {
+   if (t >= viewport.y) line(viewer, slot, x0, t, x1, t, color);
+   if (b <= y_max) line(viewer, slot, x0, b, x1, b, color);
+   if (l >= viewport.x) line(viewer, slot, l, y0, l, y1, color);
+   if (r <= x_max) line(viewer, slot, r, y0, r, y1, color);
+  }
+ }
