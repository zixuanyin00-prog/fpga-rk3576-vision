+    """Prefer the small panel's EDID mode; retain 1080p60 for other displays."""
+    match = re.search(r'^HDMI-1 connected[^\n]*(?:\n[ \t].*)*', listing, re.M)
+    if match is None:
+        raise RuntimeError('HDMI-1 is not connected')
+    header, *lines = match.group(0).splitlines()
+    rates = {}
+    for line in lines:
+        words = line.split(maxsplit=1)
+        if len(words) == 2:
+            mode, mode_rates = words
+            rates[mode] = re.findall(r'(\d+(?:\.\d+)?)[ \t]*([*+]*)', mode_rates)
+    mode, refresh = '1920x1080', '60.00'
+    compact_refresh = next((rate for rate, flags in rates.get('1024x600', ())
+                            if '+' in flags and abs(float(rate) - 60) < .10), None)
+    if compact_refresh:
+        mode, refresh = '1024x600', compact_refresh
+    mode_rates = rates.get(mode, ())
+    supported = any(float(rate) == float(refresh) for rate, _ in mode_rates)
+    current = any(float(rate) == float(refresh) and '*' in flags for rate, flags in mode_rates)
+    correct = current and bool(re.match(rf'^HDMI-1 connected primary {mode}\+0\+0(?:\s|$)', header))
+    active_dsi = re.findall(r'^(DSI-\S+) connected(?: primary)? \d+x\d+[+-]\d+[+-]\d+', listing, re.M)
+    return mode, refresh, correct, supported, active_dsi
+
 
