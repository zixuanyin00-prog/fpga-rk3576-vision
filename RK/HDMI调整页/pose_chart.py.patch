+def _draw_line_series(draw, chart, left, right, low, height, rate_max):
+    start, end = chart['window_start'], chart['window_end']
+    enabled = set(chart['enabled'])
+    plotted = False
+    for field in chart['fields']:
+        if field['key'] not in enabled:
+            continue
+        scale = rate_max if field['key'] == 'rate:throughput' else 100.
+        segment = []
+        for when, row in chart['history']:
+            value = row.get(field['key'])
+            if value is None or not start <= when <= end:
+                if len(segment) > 1:
+                    draw.line(segment, fill=field['color'], width=2)
+                segment = []
+                continue
+            segment.append((left + (when - start) / WINDOW_SECONDS * (right - left), low - value / scale * height))
+        if len(segment) > 1:
+            draw.line(segment, fill=field['color'], width=2)
+            plotted = True
+        if segment:
+            px, py = segment[-1]
+            draw.ellipse((px - 3, py - 3, px + 3, py + 3), fill=field['color'])
+            plotted = True
+    return plotted
+
