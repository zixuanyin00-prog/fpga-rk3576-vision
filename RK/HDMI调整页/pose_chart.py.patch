+def draw_display_chart(view, regions, chart, x=736, y=80, w=272, bottom=584, *, show_settings=False):
+    """Render the 1024×600 display page's chart and touch controls."""
+    from PIL import ImageDraw
+
+    surface = (19, 31, 43, 255)
+    border = (49, 69, 87, 255)
+    text = (231, 243, 248, 255)
+    muted = (167, 188, 199, 255)
+    accent = (120, 236, 208, 255)
+    throughput_color = (255, 172, 72, 255)
+    if 16 not in view.fonts:
+        view.fonts[16] = view.fonts[18].font_variant(size=16)
+    draw = ImageDraw.Draw(view.canvas)
+    draw.rounded_rectangle((x, y, x + w - 1, bottom - 1), 12, fill=surface, outline=border)
+
+    def label(value, left, top, width, size=18, color=text):
+        view.text(None, value, left, top, width, size=size, color=color)
+
+    def button(key, value, left, top, width, *, active=False):
+        hover = getattr(view, 'hover_key', None) == key
+        fill = (28, 66, 66, 255) if active else (39, 61, 75, 255) if hover else (30, 47, 61, 255)
+        draw.rounded_rectangle((left, top, left + width - 1, top + 39), 7, fill=fill,
+                               outline=accent if active else border)
+        draw.text((left + width / 2, top + 20), value, font=view.fonts[16],
+                  fill=accent if active else text, anchor='mm')
+        regions.append(dict(key=key, box=(left, top, width, 40)))
+
+    inset = x + 12
+    usable = w - 24
+    is_pie = chart['mode'] == 'pie'
+    if show_settings:
+        label('统计设置', inset, y + 17, 86, size=20)
+        button('chart:mode', '折线' if is_pie else '饼图', x + w - 172, y + 11, 74, active=is_pie)
+        button('chart_settings', '收起', x + w - 92, y + 11, 80, active=True)
+    else:
+        label('姿态分布' if is_pie else '统计趋势', inset, y + 17, usable - 80, size=22)
+        button('chart:mode', '切换折线' if is_pie else '切换饼图', x + w - 86, y + 11, 74, active=is_pie)
+
+    row_y = y + 59
+    footer_y = bottom - 51
+    if show_settings:
+        edit_interval = chart['editing'] and chart['edit_target'] == 'interval'
+        interval = (chart['edit_text'] or '输入秒数') if edit_interval else f"采样 {chart['interval']:g} 秒"
+        button('chart:minus', '−', inset, row_y, 40)
+        button('chart:interval', interval, inset + 46, row_y, usable - 138, active=edit_interval)
+        button('chart:plus', '+', x + w - 98, row_y, 40)
+        button('chart:apply', '确认', x + w - 52, row_y, 40, active=chart['editing'])
+
+        if is_pie:
+            row_y += 46
+            edit_window = chart['editing'] and chart['edit_target'] == 'window'
+            window = (chart['edit_text'] or '输入秒数') if edit_window else f"区间 {chart['pie_seconds']:g} 秒"
+            button('chart:window_minus', '−', inset, row_y, 40)
+            button('chart:window', window, inset + 46, row_y, usable - 92, active=edit_window)
+            button('chart:window_plus', '+', x + w - 52, row_y, 40)
+
+        hint = chart['error'] or ('计数清零中' if chart['awaiting_count_reset'] else
+            '输入秒数后点确认' if chart['editing'] else
+            '区间内通过总数' if is_pie else '占比 %  ·  通过速度 件/秒')
+        label(hint, inset, row_y + 44, usable, size=16,
+              color=(248, 162, 104, 255) if chart['error'] else muted)
+
+    legend_y = footer_y - (168 if show_settings else 100)
+    plot_bottom = legend_y - 14
+    enabled = set(chart['enabled'])
+    pie_percent = {}
+    palette = {}
+
+    if is_pie:
+        summary = chart['pie']
+        palette = pie_colors(tuple(sector['key'] for sector in summary.get('sectors', [])))
+        pie_percent = {sector['key']: sector['percentage'] for sector in summary.get('sectors', [])}
+        if show_settings:
+            diameter = min(116, plot_bottom - row_y - 67)
