+            label(chart['data_note'] or '正在积累区间数据', left + 8, top + height // 2 - 11,
+                  right - left - 16, size=16, color=muted)
+        label('−5秒', left, low + 3, 50, size=16, color=muted)
+        draw.text((right, low + 5), '现在', font=view.fonts[16], fill=muted, anchor='rt')
+
+    if not show_settings:
+        draw.line((inset, legend_y, x + w - 12, legend_y), fill=border)
+        counters = (('stat:total', '累计计数'), ('stat:current_present', '当前在场'))
+        for index, (key, title) in enumerate(counters):
+            counter_x = inset + index * (usable // 2)
+            label(title, counter_x, legend_y + 14, usable // 2 - 8, size=16, color=muted)
+            label(short_number(chart['latest'].get(key)), counter_x, legend_y + 39,
+                  usable // 2 - 8, size=28)
+        button('chart_settings', '统计设置', x + w - 124, footer_y, 112)
+        return
+
+    draw.line((inset, legend_y, x + w - 12, legend_y), fill=border)
+    label('累计 / 区间占比' if is_pie else '累计计数 · 点选曲线', inset, legend_y + 4, usable, size=16, color=muted)
+    pages = max(1, (len(chart['fields']) + PAGE_SIZE - 1) // PAGE_SIZE)
+    page = chart['page']
+    visible_fields = chart['fields'][page * PAGE_SIZE:(page + 1) * PAGE_SIZE]
+    cell = (usable - 6) // 2
+    for index, field in enumerate(visible_fields):
+        field_x = inset + (index % 2) * (cell + 6)
+        field_y = legend_y + 24 + (index // 2) * 27
+        key = field['key']
+        on = key in pie_percent if is_pie else key in enabled
+        shade = palette.get(key, (149, 173, 186)) if is_pie else field['color']
+        if is_pie:
+            draw.ellipse((field_x + 2, field_y + 7, field_x + 12, field_y + 17),
